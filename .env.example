# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Token Bot Telegram dari @BotFather untuk mengirim notifikasi & foto bukti pengiriman otomatis ke pelanggan.
# Simpan di panel Secrets AI Studio (hanya digunakan di sisi server, tidak pernah terekspos ke browser).
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_ADMIN_CHAT_ID: (Opsional) Chat ID grup/admin Telegram toko untuk menerima salinan otomatis bukti pengiriman.
TELEGRAM_ADMIN_CHAT_ID=""

# VITE_TELEGRAM_BOT_USERNAME: (Opsional) Username Bot Telegram toko tanpa "@" untuk koneksi chat otomatis pelanggan.
VITE_TELEGRAM_BOT_USERNAME=""

# INTEGRASI JOURNAL POS (Hanya sisi server — jangan pernah pakai prefix VITE_ atau simpan di browser)
# Endpoint resmi yang terdeteksi: https://journal.alpa.gdn/web/api/v1/products & /api/v1/ping
JOURNAL_POS_BASE_URL="https://journal.alpa.gdn/web"
JOURNAL_POS_API_KEY=""
JOURNAL_POS_API_SECRET=""
JOURNAL_POS_WEBHOOK_SECRET=""
JOURNAL_POS_SIGNATURE_FORMAT="method_path_timestamp"


