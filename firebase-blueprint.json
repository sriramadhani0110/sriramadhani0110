        },
        "locationCoords": {
          "type": "string",
          "maxLength": 80
        },
        "locationUrl": {
          "type": "string",
          "maxLength": 300
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "name", "email", "phone", "address", "city", "postalCode", "updatedAt"]
    },
    "Promotion": {
      "title": "Promotion",
      "description": "Storefront promotion for Combo (Buy X Free Y), Buy X Get Y (buy_x_get_y), and percentage discounts (discount) with automatic start/expiry schedule and auto-zero stock.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 4,
          "maxLength": 400
        },
        "promoType": {
          "type": "string",
          "enum": ["discount", "buy_x_get_y", "combo"]
        },
        "productId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "discountPercent": {
          "type": "integer"
        },
        "buyQty": {
          "type": "integer"
        },
        "getQty": {
          "type": "integer"
        },
        "startDate": {
          "type": "string",
          "maxLength": 40
        },
        "endDate": {
          "type": "string",
          "maxLength": 40
        },
        "autoZeroStockOnExpiry": {
          "type": "boolean"
        },
        "expiredStockZeroedAt": {
          "type": "string",
          "maxLength": 64
        },
        "isActive": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "promoType",
        "productId",
        "discountPercent",
        "buyQty",
        "getQty",
        "isActive",
        "createdAt",
        "updatedAt"
      ]
    },
    "StoreCategory": {
      "title": "StoreCategory",
