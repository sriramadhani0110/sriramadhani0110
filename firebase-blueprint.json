    "StoreCheckoutConfig": {
      "title": "StoreCheckoutConfig",
      "description": "Public storefront cart, checkout flow, shipping, exchange rate, and payment QR/barcode configuration managed by Admin.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "cartTitle": { "type": "string", "minLength": 2, "maxLength": 60 },
