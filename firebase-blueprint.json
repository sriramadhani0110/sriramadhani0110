        },
        "activeEmailHashes": {
          "type": "array"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "activeEmailHashes", "updatedBy", "updatedAt"]
    },
