        "primaryCurrencySymbol": { "type": "string", "minLength": 1, "maxLength": 8 },
        "secondaryCurrencyCode": { "type": "string", "enum": ["KHR", "USD", "IDR", "THB", "MYR", "SGD", "VND"] },
        "secondaryCurrencySymbol": { "type": "string", "minLength": 1, "maxLength": 8 },
        "exchangeRate": { "type": "number" },
        "themeAccent": { "type": "string", "enum": ["blue_red", "emerald", "indigo", "amber", "rose", "slate"] },
        "storeAddress": { "type": "string", "maxLength": 200 },
        "storeHours": { "type": "string", "maxLength": 80 },
        "telegramOrderUrl": { "type": "string", "maxLength": 200 },
        "permanentStoreUrl": { "type": "string", "maxLength": 240 },
        "announcementBarText": { "type": "string", "maxLength": 160 },
        "maintenanceMode": { "type": "boolean" },
        "updatedBy": { "type": "string", "minLength": 2, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "storeName", "storeTagline", "storeLogoUrl", "footerText",
        "primaryCurrencyCode", "primaryCurrencySymbol", "secondaryCurrencyCode",
        "secondaryCurrencySymbol", "exchangeRate", "themeAccent", "storeAddress",
        "storeHours", "telegramOrderUrl", "announcementBarText", "maintenanceMode",
        "updatedBy", "updatedAt"
      ]
    },
    "StoreHoursConfig": {
      "title": "StoreHoursConfig",
      "description": "Public storefront opening and closing hours template configuration managed by Admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "enabled": { "type": "boolean" },
        "mode": { "type": "string", "enum": ["auto", "force_open", "force_closed"] },
        "openTime": { "type": "string", "minLength": 5, "maxLength": 5, "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "closeTime": { "type": "string", "minLength": 5, "maxLength": 5, "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "timezoneLabel": { "type": "string", "minLength": 2, "maxLength": 16 },
        "openDaysText": { "type": "string", "minLength": 2, "maxLength": 60 },
        "blockCheckoutWhenClosed": { "type": "boolean" },
        "closedTitle": { "type": "string", "minLength": 2, "maxLength": 80 },
        "closedMessage": { "type": "string", "maxLength": 240 },
        "openNotice": { "type": "string", "maxLength": 160 },
        "updatedBy": { "type": "string", "minLength": 2, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "enabled", "mode", "openTime", "closeTime", "timezoneLabel",
        "openDaysText", "blockCheckoutWhenClosed", "closedTitle", "closedMessage",
        "openNotice", "updatedBy", "updatedAt"
      ]
    },
    "ProductPrivateMeta": {
      "title": "ProductPrivateMeta",
      "description": "Strictly Admin-only product cost/buy price metadata isolated from public /products catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productId": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "externalId": { "type": "string", "maxLength": 80 },
        "sku": { "type": "string", "minLength": 1, "maxLength": 40 },
        "barcode": { "type": "string", "maxLength": 64 },
        "costPriceUsd": { "type": "number" },
        "costPriceKhr": { "type": "number" },
        "sourceUpdatedAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "productId", "sku", "costPriceUsd", "costPriceKhr", "updatedAt"]
    },
    "JournalPosConfig": {
      "title": "JournalPosConfig",
      "description": "Admin-only non-secret JOURNAL POS sync settings, connection status, and permanent store URL.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "baseUrl": { "type": "string", "minLength": 8, "maxLength": 200 },
        "productsEndpoint": { "type": "string", "minLength": 2, "maxLength": 120 },
        "pingEndpoint": { "type": "string", "minLength": 2, "maxLength": 120 },
        "autoSyncEnabled": { "type": "boolean" },
        "syncIntervalSeconds": { "type": "integer" },
        "signatureFormat": { "type": "string", "enum": ["method_path_timestamp", "timestamp_method_path", "timestamp_path", "timestamp_only"] },
        "connectionStatus": { "type": "string", "enum": ["idle", "online", "syncing", "error", "updated"] },
        "lastSyncAtIso": { "type": "string", "maxLength": 64 },
        "lastSyncSummary": { "type": "string", "maxLength": 300 },
        "lastSuccessCount": { "type": "integer" },
        "lastUpdatedCount": { "type": "integer" },
        "lastInsertedCount": { "type": "integer" },
        "lastFailedCount": { "type": "integer" },
        "lastErrorDetail": { "type": "string", "maxLength": 400 },
        "permanentStoreUrl": { "type": "string", "maxLength": 240 },
        "updatedBy": { "type": "string", "minLength": 2, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "baseUrl", "productsEndpoint", "pingEndpoint", "autoSyncEnabled",
        "syncIntervalSeconds", "signatureFormat", "connectionStatus", "lastSyncAtIso",
        "lastSyncSummary", "lastSuccessCount", "lastUpdatedCount", "lastInsertedCount",
        "lastFailedCount", "lastErrorDetail", "permanentStoreUrl", "updatedBy", "updatedAt"
      ]
    },
    "JournalPosSyncLog": {
      "title": "JournalPosSyncLog",
      "description": "Immutable Admin-only audit log of JOURNAL POS product synchronization runs.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "trigger": { "type": "string", "enum": ["manual", "auto", "webhook", "test_sample", "json_import"] },
        "status": { "type": "string", "enum": ["online", "updated", "error"] },
        "totalFetched": { "type": "integer" },
        "successCount": { "type": "integer" },
        "insertedCount": { "type": "integer" },
        "updatedCount": { "type": "integer" },
        "failedCount": { "type": "integer" },
        "summary": { "type": "string", "minLength": 2, "maxLength": 300 },
        "errorDetail": { "type": "string", "maxLength": 400 },
        "changedSkus": { "type": "array" },
        "triggeredBy": { "type": "string", "minLength": 2, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "trigger", "status", "totalFetched", "successCount", "insertedCount",
        "updatedCount", "failedCount", "summary", "errorDetail", "changedSkus",
        "triggeredBy", "createdAt"
      ]
    },
    "BackupArchiveRecord": {
      "title": "BackupArchiveRecord",
      "description": "Immutable Admin-only audit record of master data JSON/ZIP backup exports.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "filename": { "type": "string", "minLength": 4, "maxLength": 160 },
        "format": { "type": "string", "enum": ["json", "zip"] },
        "totalCollections": { "type": "integer" },
        "totalDocuments": { "type": "integer" },
        "triggeredBy": { "type": "string", "minLength": 2, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "filename", "format", "totalCollections", "totalDocuments", "triggeredBy", "createdAt"]
    },
    "StoreBackgroundConfig": {
      "title": "StoreBackgroundConfig",
      "description": "Global background image configuration applied across all 4 portals (Customer, Delivery, Admin, Master Data) and editable by Admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "enum": ["background"] },
        "imageUrl": { "type": "string", "maxLength": 250000 },
        "displayMode": { "type": "string", "enum": ["watermark_center", "watermark_tile", "cover"] },
        "opacity": { "type": "integer", "minimum": 5, "maximum": 85 },
        "enabled": { "type": "boolean" },
        "updatedBy": { "type": "string", "minLength": 2, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "imageUrl", "displayMode", "opacity", "enabled", "updatedBy", "updatedAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Marketplace product catalog documents (public selling info only, never cost price)."
    },
    "/productPrivateMeta/{productId}": {
      "schema": { "$ref": "#/entities/ProductPrivateMeta" },
      "description": "Strictly Admin-only product cost/buy prices isolated from customers."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/StoreCategory" },
      "description": "Admin-managed product categories shown in storefront and catalog filters."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer checkout orders visible to the order owner, admin, and active read-only delivery accounts."
    },
    "/deliveryAccounts/{accountId}": {
      "schema": { "$ref": "#/entities/DeliveryAccount" },
      "description": "Authorized read-only delivery courier accounts managed by Admin."
    },
    "/storeMeta/{docId}": {
      "schema": { "$ref": "#/entities/DeliveryRoster" },
      "description": "Non-PII delivery routing hashes for automatic order dispatch."
    },
    "/storeSupport/{docId}": {
      "schema": { "$ref": "#/entities/StoreSupportConfig" },
      "description": "Public Telegram support contact managed by Admin for the floating customer chat widget."
    },
    "/storeBanners/{bannerId}": {
      "schema": { "$ref": "#/entities/StoreBanner" },
      "description": "Homepage carousel banners and announcements managed by Admin."
    },
    "/storeConfig/{docId}": {
      "schema": { "$ref": "#/entities/StoreCheckoutConfig" },
      "description": "Public storefront cart, checkout, master branding, opening hours, and global background image settings (/storeConfig/checkout, /storeConfig/master, /storeConfig/hours, /storeConfig/background)."
    },
    "/integrationConfig/{docId}": {
      "schema": { "$ref": "#/entities/JournalPosConfig" },
      "description": "Admin-only JOURNAL POS integration settings (no secrets stored)."
    },
    "/journalPosSyncLogs/{logId}": {
      "schema": { "$ref": "#/entities/JournalPosSyncLog" },
      "description": "Admin-only immutable synchronization audit history for JOURNAL POS."
    },
    "/backupArchives/{backupId}": {
      "schema": { "$ref": "#/entities/BackupArchiveRecord" },
      "description": "Admin-only immutable history of exported JSON/ZIP master backups."
    },
    "/automationSettings/{settingId}": {
      "schema": { "$ref": "#/entities/AutomationSettings" },
      "description": "ROBOTO automated order processing settings."
    },
    "/automationLogs/{logId}": {
      "schema": { "$ref": "#/entities/AutomationLog" },
      "description": "Chronological ROBOTO engine execution log."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminProfile" },
      "description": "Authorized admin accounts."
    },
    "/users/{uid}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private customer shipping PII isolated under user private subcollection."
    },
    "/promotions/{promoId}": {
      "schema": { "$ref": "#/entities/Promotion" },
      "description": "Active discount and Buy X Get Y promotions managed by Admin and shown on dedicated customer discount page."
    }
  }
}
