    "StoreMasterConfig": {
      "title": "StoreMasterConfig",
      "description": "Master Data global store branding, logo, currencies, exchange rate, theme, operational hours, and announcement settings managed exclusively by Master Data accounts.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
