        "cashTitle": { "type": "string", "minLength": 2, "maxLength": 40 },
        "cashDescription": { "type": "string", "maxLength": 160 },
        "enableQrPayment": { "type": "boolean" },
        "qrTitle": { "type": "string", "minLength": 2, "maxLength": 40 },
        "qrDescription": { "type": "string", "maxLength": 160 },
        "exchangeRateKhr": { "type": "integer" },
        "paymentProviderName": { "type": "string", "minLength": 2, "maxLength": 40 },
        "paymentTagline": { "type": "string", "maxLength": 80 },
        "merchantName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "accountHolder": { "type": "string", "minLength": 2, "maxLength": 80 },
