          "type": "string",
          "minLength": 5,
          "maxLength": 120
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "name", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
