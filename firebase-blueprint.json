{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Catalog product item available in ALPAMART TRIMUIA ONLAINE marketplace (base price in USD).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "sku": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "barcode": {
          "type": "string",
          "maxLength": 64
        },
        "externalId": {
          "type": "string",
          "maxLength": 80
        },
        "category": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "minLength": 4,
          "maxLength": 1000
        },
        "price": {
          "type": "number"
        },
        "priceKhr": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "enum": ["PCS", "PACK", "BOX", "KG", "LITER", "RENTENG", "COMBO", "BKS", "BOTOL", "DUS", "UNIT", "SET", "CTN", "GR", "ML"]
        },
        "stock": {
          "type": "integer"
        },
        "imageUrl": {
          "type": "string",
          "minLength": 4,
          "maxLength": 500
        },
        "isActive": {
          "type": "boolean"
        },
        "promoActive": {
          "type": "boolean"
        },
        "promoPriceUsd": {
          "type": "number"
        },
        "promoPriceKhr": {
          "type": "number"
        },
        "promoDiscountPercent": {
          "type": "integer"
        },
        "promoStartDate": {
          "type": "string",
          "maxLength": 40
        },
        "promoEndDate": {
          "type": "string",
          "maxLength": 40
        },
        "promoLabel": {
          "type": "string",
          "maxLength": 40
        },
        "syncSource": {
          "type": "string",
          "enum": ["manual", "journal_pos"]
        },
        "sourceUpdatedAt": {
          "type": "string",
          "maxLength": 64
        },
        "lastOrderId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "sku", "category", "description", "price", "stock", "imageUrl", "isActive", "createdAt", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer checkout order routed into the Admin ROBOTO queue with KHR (CASH) or USD (QR) payment currency.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderNumber": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "customerId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "customerEmail": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120
        },
        "customerPhone": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64
        },
        "shippingAddress": {
          "type": "string",
          "maxLength": 400
        },
        "city": {
          "type": "string",
          "maxLength": 80
        },
        "postalCode": {
          "type": "string",
          "maxLength": 12
        },
        "locationDetail": {
          "type": "string",
          "maxLength": 240
        },
        "locationCoords": {
          "type": "string",
          "maxLength": 80
        },
        "locationUrl": {
          "type": "string",
          "maxLength": 300
        },
        "locationImageUrl": {
          "type": "string",
          "maxLength": 250000
        },
        "deliveryProofImageUrl": {
          "type": "string",
          "maxLength": 350000
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["CASH", "QR"]
        },
        "currency": {
          "type": "string",
          "enum": ["KHR", "USD", "IDR", "THB", "MYR", "SGD", "VND"]
        },
        "shippingMethod": {
          "type": "string",
          "enum": ["FREE DELIVERY", "ROBOTO Express", "Reguler", "Same Day"]
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        },
        "items": {
          "type": "array"
        },
        "subtotal": {
          "type": "number"
        },
        "shippingCost": {
          "type": "number"
        },
        "totalAmount": {
          "type": "number"
        },
        "trackingNumber": {
          "type": "string",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": ["pending", "processing", "shipped", "completed", "cancelled"]
        },
        "autoProcessed": {
          "type": "boolean"
        },
        "deliveryEmailHashes": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "orderNumber",
        "customerId",
        "customerName",
        "customerEmail",
        "customerPhone",
        "shippingAddress",
        "city",
        "postalCode",
        "paymentMethod",
        "currency",
        "shippingMethod",
        "notes",
        "items",
        "subtotal",
        "shippingCost",
        "totalAmount",
        "trackingNumber",
        "status",
        "autoProcessed",
        "createdAt",
        "updatedAt"
      ]
    },
    "AutomationSettings": {
      "title": "AutomationSettings",
      "description": "Configuration for the ROBOTO automated order processing engine.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "autoConfirmOrders": {
          "type": "boolean"
        },
        "autoGenerateResi": {
          "type": "boolean"
        },
        "autoDeductStock": {
          "type": "boolean"
        },
        "lowStockThreshold": {
          "type": "integer"
        },
        "defaultCourierPrefix": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16
        },
        "updatedBy": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "autoConfirmOrders", "autoGenerateResi", "autoDeductStock", "lowStockThreshold", "defaultCourierPrefix", "updatedBy", "updatedAt"]
    },
    "AutomationLog": {
      "title": "AutomationLog",
      "description": "Immutable audit log of automated ROBOTO order actions.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderNumber": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "action": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "detail": {
          "type": "string",
          "minLength": 2,
          "maxLength": 400
        },
        "status": {
          "type": "string",
          "enum": ["success", "warning"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "orderId", "orderNumber", "action", "detail", "status", "createdAt"]
    },
    "AdminProfile": {
      "title": "AdminProfile",
      "description": "Authorized admin account entry.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
